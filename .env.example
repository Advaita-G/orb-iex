# Copy to .env, fill in PAPER keys, then: chmod 600 .env
# Get paper keys from the Alpaca dashboard with the Paper account selected.
# Never commit .env (it is in .gitignore).
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional. If set, it must be the paper host or the bot refuses to start.
# There is no way to point ORB-IEX at the live host.
# APCA_API_BASE_URL=https://paper-api.alpaca.markets
# This machine's identity (paper mode). Must equal safety.account_owner_instance_id in the settings file, or the bot
# refuses to trade. Use a different value on every machine; never copy this line between machines.
# ORB_IEX_INSTANCE_ID=mac

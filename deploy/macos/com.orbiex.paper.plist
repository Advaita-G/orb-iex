<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.orbiex.paper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-is</string>
        <string>~/orb-iex/.venv/bin/python</string>
        <string>-u</string>
        <string>-m</string>
        <string>orb_iex</string>
        <string>paper-supervise</string>
    </array>
    <key>WorkingDirectory</key>
    <string>~/orb-iex</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ORB_IEX_INSTANCE_ID</key>
        <string>orb-mac-supervised</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>~/orb-iex/runtime/logs/paper-supervise-console.log</string>
    <key>StandardErrorPath</key>
    <string>~/orb-iex/runtime/logs/paper-supervise-console.log</string>
</dict>
</plist>

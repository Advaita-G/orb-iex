<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ORB_IEX_INSTANCE_ID</key>
		<string>orb-mac-supervised</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.orbiex.gapup-shadow</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-is</string>
		<string>~/orb-iex/.venv/bin/python</string>
		<string>-u</string>
		<string>-m</string>
		<string>orb_iex.gapup_shadow</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>~/orb-iex/runtime/logs/com.orbiex.gapup-shadow.log</string>
	<key>StandardOutPath</key>
	<string>~/orb-iex/runtime/logs/com.orbiex.gapup-shadow.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>~/orb-iex</string>
</dict>
</plist>
